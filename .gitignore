# Rebuilt on every run; no reason to version them.
pipeline/.cache/
__pycache__/
*.pyc
node_modules/

# Scryfall card scans and rendered slides are regenerated by the daily job.
# Keeping them out of a public repo also avoids re-hosting card images in bulk.
queue/*/images/
queue/*/slide*.jpg
_site/

# Large media / local experiments
avatars/out/
*.mp4
*.mp3

# Never commit a token.
*.token
.env

# Handover material from the previous platform; private, not needed to run.
PLAN.md
UEBERGABE.md
EDHPod-Export/

# Talking-head avatar experiment and the old review page; not part of publishing.
avatars/
review.html
pipeline/setup_sadtalker.sh
pipeline/talking_head.sh
